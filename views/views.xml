<odoo>
  <data>

    <!-- Company form: BIN -->
    <record id="res_company_form_inherit" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="bin"/>
            </xpath>
        </field>
    </record>

    <!-- Partner form: BIN -->
    <record id="res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="bin"/>
            </xpath>
        </field>
    </record>

    <!-- Language selection wizard view -->
    <record id="vat_challan_print_wizard_form" model="ir.ui.view">
        <field name="name">vat.challan.print.wizard.form</field>
        <field name="model">vat.challan.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print VAT 6.3 Challan">
                <group>
                    <field name="invoice_id" invisible="1"/>
                    <field name="lang" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print"
                            string="Print"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Invoice form -->
    <record id="account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Invoice Time + Mushak No. -->
            <xpath expr="//field[@name='delivery_date']" position="after">
                <field name="time_invoice"
                       readonly="vat_challan_no != False"
                       invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="vat_challan_no"
                       readonly="1"
                       invisible="not vat_challan_no"/>
            </xpath>

            <!-- Smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">

                <!-- Generate: visible only when no challan no yet -->
                <button name="action_generate_vat_challan_no"
                        string="Generate Mushak 6.3"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-hashtag"
                        invisible="vat_challan_no != False or move_type not in ['out_invoice','out_refund']"
                        groups="account.group_account_invoice"/>

                <!-- Print: visible only when challan no is set -->
                <button name="action_print_vat_challan_wizard"
                        string="Print VAT 6.3"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-print"
                        invisible="not vat_challan_no or move_type not in ['out_invoice','out_refund']"
                        groups="account.group_account_invoice"/>

            </xpath>

            <!-- Supplementary Duty column on invoice lines -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="after">
                <field name="invoice_line_supplementary_tax"
                       optional="show"
                       string="Suppl. Duty"/>
            </xpath>

        </field>
    </record>

  </data>
</odoo>
