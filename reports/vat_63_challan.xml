<odoo>
  <data>

    <template id="report_vat_63_challan">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
          <t t-call="vat_bd_6_3.vat_63_challan_doc"/>
        </t>
      </t>
    </template>

    <template id="vat_63_challan_doc">
      <t t-set="res_company" t-value="o.company_id"/>
      <t t-set="is_bn" t-value="o.challan_print_lang == 'bn_IN'"/>

      <!--
        bn(val) converts any value to a string then replaces
        ASCII digits 0-9 with Bengali digits ০-৯.
        Used for every numeric cell when is_bn is True.
      -->
      <t t-set="bn" t-value="lambda v: str(v).translate(str.maketrans('0123456789', '০১২৩৪৫৬৭৮৯'))"/>

      <!--
        fmt_money(amount, currency) renders a monetary value the same way
        Odoo's monetary widget does (2 decimal places + currency symbol),
        then optionally converts digits to Bengali.
      -->
      <t t-set="fmt_money" t-value="lambda amt, cur: (cur.symbol + '\u00a0' + bn('{:,.2f}'.format(amt))) if is_bn else (cur.symbol + '\u00a0' + '{:,.2f}'.format(amt))"/>

      <div>
        <!-- ======= HEADER ======= -->
        <div class="header" width="100%">
          <style>
            @font-face {
              font-family: Bangla;
              src: url(/vat_bd_6_3/static/src/fonts/kalpurush.ttf);
            }
            div, td, th, span, strong, small, h3, h5 {
              font-family: Bangla, Arial, sans-serif;
            }
          </style>
          <table class="table table-bordered" style="border-color:white;" width="100%">
            <tr>
              <td rowspan="2" width="15%" style="border-color:white;">
                <img src="/vat_bd_6_3/static/src/img/bd_gov_logo.png" style="width:100%"/>
              </td>
              <td rowspan="2" width="72%" style="text-align:center;">
                <div t-if="not is_bn">Government of the People's Republic of Bangladesh</div>
                <div t-if="is_bn">গণপ্রজাতন্ত্রী বাংলাদেশ সরকার</div>
                <h3 t-if="not is_bn">National Board of Revenue</h3>
                <h3 t-if="is_bn">জাতীয় রাজস্ব বোর্ড</h3>
                <h5 t-if="not is_bn">Tax Challan</h5>
                <h5 t-if="is_bn">কর চালানপত্র</h5>
                <small t-if="not is_bn">[See Clauses (C) and (f) of Sub-Rule (1) of Rule 40]</small>
                <small t-if="is_bn">[বিধি ৪০ এর উপ-বিধি (১) এ (ক) ও (চ) দ্রষ্টব্য]</small>
              </td>
              <td style="border:1px solid black !important;text-align:center;padding:6px;width:13%">
                <strong>MUSHAK 6.3</strong><br/>
                <span t-esc="bn(o.name) if is_bn else o.name" style="font-size:8px;"/>
              </td>
            </tr>
            <tr></tr>
            <tr>
              <td></td>
              <td>
                <div t-if="res_company.name">
                  <strong t-if="not is_bn">Name of Registered Person:</strong>
                  <strong t-if="is_bn">নিবন্ধিত ব্যক্তির নামঃ</strong>
                  <span t-field="res_company.name"/>
                </div>
                <div>
                  <strong t-if="not is_bn">BIN:</strong>
                  <strong t-if="is_bn">বিআইএনঃ</strong>
                  <t t-if="not is_bn"><span t-field="res_company.bin"/></t>
                  <t t-if="is_bn"><span t-esc="bn(res_company.bin or '')"/></t>
                </div>
                <div>
                  <strong t-if="not is_bn">Address:</strong>
                  <strong t-if="is_bn">ঠিকানাঃ</strong>
                  <t t-if="res_company.street"><span t-field="res_company.street"/>, </t>
                  <t t-if="res_company.street2"><span t-field="res_company.street2"/>, </t>
                  <t t-if="res_company.country_id"><span t-field="res_company.country_id"/></t>
                </div>
              </td>
              <td></td>
            </tr>
          </table>
        </div>

        <!-- ======= BODY ======= -->
        <div class="article">
          <div class="page">
            <style>table, td, th { border: 1px solid black; }</style>

            <table class="table table-condensed" name="invoice_line_table">
              <thead>
                <tr>
                  <th colspan="10">
                    <div class="row" style="margin-bottom:4px;">
                      <div class="col-3">
                        <strong t-if="not is_bn">Name of Purchaser:</strong>
                        <strong t-if="is_bn">ক্রেতার নামঃ</strong>
                      </div>
                      <div class="col-3"><span t-field="o.partner_id"/></div>
                      <div class="col-3">
                        <strong t-if="not is_bn">Challan No.:</strong>
                        <strong t-if="is_bn">চালানপত্র নম্বরঃ</strong>
                      </div>
                      <div class="col-3">
                        <t t-if="not is_bn"><span t-field="o.vat_challan_no"/></t>
                        <t t-if="is_bn"><span t-esc="bn(o.vat_challan_no or '')"/></t>
                      </div>
                    </div>
                    <div class="row" style="margin-bottom:4px;">
                      <div class="col-3">
                        <strong t-if="not is_bn">BIN of Purchaser:</strong>
                        <strong t-if="is_bn">ক্রেতার বিআইএনঃ</strong>
                      </div>
                      <div class="col-3">
                        <t t-if="not is_bn"><span t-field="o.partner_id.bin"/></t>
                        <t t-if="is_bn"><span t-esc="bn(o.partner_id.bin or '')"/></t>
                      </div>
                      <div class="col-3">
                        <strong t-if="not is_bn">Date of Issue:</strong>
                        <strong t-if="is_bn">ইস্যুর তারিখঃ</strong>
                      </div>
                      <div class="col-3">
                        <t t-if="not is_bn"><span t-esc="o.date.strftime('%d/%m/%Y') if o.date else ''"/></t>
                        <t t-if="is_bn"><span t-esc="bn(o.date.strftime('%d/%m/%Y')) if o.date else ''"/></t>
                      </div>
                    </div>
                    <div class="row" style="margin-bottom:4px;">
                      <div class="col-3">
                        <strong t-if="not is_bn">Destination of Supply:</strong>
                        <strong t-if="is_bn">সরবরাহের গন্তব্যস্থলঃ</strong>
                      </div>
                      <div class="col-3">
                        <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/>, </t>
                        <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/></t>
                      </div>
                      <div class="col-3">
                        <strong t-if="not is_bn">Time of Issue:</strong>
                        <strong t-if="is_bn">ইস্যুর সময়ঃ</strong>
                      </div>
                      <div class="col-3">

                        <t t-if="not is_bn"><span t-esc="context_timestamp(o.time_invoice).strftime('%H:%M:%S')"/></t>
                        <t t-if="is_bn"><span t-esc="bn(context_timestamp(o.time_invoice).strftime('%H:%M:%S'))"/></t>
                      </div>
                    </div>
                  </th>
                </tr>
                <tr>
                  <th class="text-center" width="3%">
                    <t t-if="not is_bn">SL</t><t t-if="is_bn">ক্রমিক নং</t>
                  </th>
                  <th class="text-left" width="25%">
                    <t t-if="not is_bn">Goods / Service Description (with Brand Name)</t>
                    <t t-if="is_bn">পণ্য/সেবার বিবরণ (ব্র্যান্ড নামসহ)</t>
                  </th>
                  <th class="text-center" width="7%">
                    <t t-if="not is_bn">Unit</t><t t-if="is_bn">একক</t>
                  </th>
                  <th class="text-center" width="6%">
                    <t t-if="not is_bn">Qty</t><t t-if="is_bn">পরিমাণ</t>
                  </th>
                  <th class="text-right" width="10%">
                    <t t-if="not is_bn">Unit Value (BDT)</t><t t-if="is_bn">একক মূল্য (টাকা)</t>
                  </th>
                  <th class="text-right" width="12%">
                    <t t-if="not is_bn">Total Value (BDT)</t><t t-if="is_bn">মোট মূল্য (টাকা)</t>
                  </th>
                  <th class="text-right" width="10%">
                    <t t-if="not is_bn">Suppl. Duty (BDT)</t><t t-if="is_bn">সম্পূরক শুল্ক (টাকা)</t>
                  </th>
                  <th class="text-center" width="8%">
                    <t t-if="not is_bn">VAT Rate</t><t t-if="is_bn">ভ্যাট হার</t>
                  </th>
                  <th class="text-right" width="10%">
                    <t t-if="not is_bn">VAT Amount (BDT)</t><t t-if="is_bn">ভ্যাট পরিমাণ (টাকা)</t>
                  </th>
                  <th class="text-right" width="12%">
                    <t t-if="not is_bn">Total incl. Duty &amp; Tax (BDT)</t>
                    <t t-if="is_bn">শুল্ক ও কর সহ মোট (টাকা)</t>
                  </th>
                </tr>
              </thead>

              <tbody class="invoice_tbody">
                <t t-set="total_sd" t-value="0"/>
                <t t-set="serial"   t-value="1"/>

                <t t-foreach="o.invoice_line_ids" t-as="l">
                  <tr t-if="l.display_type not in ('line_section', 'line_note')">
                    <td class="text-center">
                      <t t-if="not is_bn"><span t-esc="serial"/></t>
                      <t t-if="is_bn"><span t-esc="bn(serial)"/></t>
                      <t t-set="serial" t-value="serial + 1"/>
                    </td>
                    <td><span t-field="l.name"/></td>
                    <td class="text-center"><span t-field="l.product_uom_id"/></td>
                    <td class="text-center">
                      <t t-if="not is_bn"><span t-field="l.quantity"/></t>
                      <t t-if="is_bn"><span t-esc="bn(l.quantity)"/></t>
                    </td>
                    <td class="text-right" style="white-space:nowrap;">
                      <t t-if="not is_bn"><span t-field="l.price_unit"/></t>
                      <t t-if="is_bn"><span t-esc="fmt_money(l.price_unit, o.currency_id)"/></t>
                    </td>
                    <td class="text-right" style="white-space:nowrap;">
                      <t t-if="not is_bn">
                        <span t-field="l.price_subtotal"
                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                      </t>
                      <t t-if="is_bn"><span t-esc="fmt_money(l.price_subtotal, o.currency_id)"/></t>
                    </td>
                    <t t-set="total_sd" t-value="total_sd + l.invoice_line_supplementary_tax"/>
                    <td class="text-right" style="white-space:nowrap;">
                      <t t-if="not is_bn">
                        <span t-esc="l.invoice_line_supplementary_tax"
                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                      </t>
                      <t t-if="is_bn"><span t-esc="fmt_money(l.invoice_line_supplementary_tax, o.currency_id)"/></t>
                    </td>
                    <td class="text-center" style="white-space:nowrap;">
                      <t t-set="tax_label" t-value="', '.join(map(lambda x: x.description or x.name, l.tax_ids))"/>
                      <t t-if="not is_bn"><span t-esc="tax_label"/></t>
                      <t t-if="is_bn"><span t-esc="bn(tax_label)"/></t>
                    </td>
                    <t t-set="line_vat" t-value="l.price_total - l.price_subtotal"/>
                    <td class="text-right" style="white-space:nowrap;">
                      <t t-if="not is_bn">
                        <span t-esc="line_vat"
                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                      </t>
                      <t t-if="is_bn"><span t-esc="fmt_money(line_vat, o.currency_id)"/></t>
                    </td>
                    <td class="text-right" style="white-space:nowrap;">
                      <t t-set="line_total" t-value="l.price_subtotal + l.invoice_line_supplementary_tax + line_vat"/>
                      <t t-if="not is_bn">
                        <span t-esc="line_total"
                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                      </t>
                      <t t-if="is_bn"><span t-esc="fmt_money(line_total, o.currency_id)"/></t>
                    </td>
                  </tr>
                </t>

                <!-- Padding rows to minimum 5 product lines -->
                <t t-set="line_count" t-value="len([l for l in o.invoice_line_ids if l.display_type not in ('line_section', 'line_note')])"/>
                <tr t-foreach="range(max(5 - line_count, 0))" t-as="pad">
                  <td t-translation="off">&amp;nbsp;</td>
                  <td></td><td></td><td></td><td></td>
                  <td></td><td></td><td></td><td></td><td></td>
                </tr>

                <!-- Total row -->
                <tr>
                  <td colspan="5" class="text-right">
                    <strong t-if="not is_bn">Total</strong>
                    <strong t-if="is_bn">মোট</strong>
                  </td>
                  <td class="text-right" style="white-space:nowrap;">
                    <t t-if="not is_bn">
                      <span t-field="o.amount_untaxed"
                            t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                    </t>
                    <t t-if="is_bn"><span t-esc="fmt_money(o.amount_untaxed, o.currency_id)"/></t>
                  </td>
                  <td class="text-right" style="white-space:nowrap;">
                    <t t-if="not is_bn">
                      <span t-esc="total_sd"
                            t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                    </t>
                    <t t-if="is_bn"><span t-esc="fmt_money(total_sd, o.currency_id)"/></t>
                  </td>
                  <td></td>
                  <td class="text-right" style="white-space:nowrap;">
                    <t t-if="not is_bn">
                      <span t-field="o.amount_tax"
                            t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                    </t>
                    <t t-if="is_bn"><span t-esc="fmt_money(o.amount_tax, o.currency_id)"/></t>
                  </td>
                  <td class="text-right" style="white-space:nowrap;">
                    <t t-if="not is_bn">
                      <span t-field="o.amount_total"
                            t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                    </t>
                    <t t-if="is_bn"><span t-esc="fmt_money(o.amount_total, o.currency_id)"/></t>
                  </td>
                </tr>
              </tbody>
            </table>

            <div class="row"><br/><br/></div>

            <div class="row">
              <div class="col-5">
                <strong t-if="not is_bn">Name of Officer-in-Charge:</strong>
                <strong t-if="is_bn">দায়িত্বপ্রাপ্ত কর্মকর্তার নামঃ</strong>
              </div>
              <div class="col-7"><span t-field="o.user_id"/></div>
            </div>
            <div class="row">
              <div class="col-5">
                <strong t-if="not is_bn">Designation:</strong>
                <strong t-if="is_bn">পদবীঃ</strong>
              </div>
              <div class="col-7"><span t-field="o.user_id.partner_id.function"/></div>
            </div>
            <div class="row">
              <div class="col-5">
                <strong t-if="not is_bn">Signature:</strong>
                <strong t-if="is_bn">স্বাক্ষরঃ</strong>
              </div>
              <div class="col-7"><br/><br/><br/></div>
            </div>
            <div class="row">
              <div class="col-5">
                <strong t-if="not is_bn">Seal:</strong>
                <strong t-if="is_bn">সীলঃ</strong>
              </div>
              <div class="col-7"><br/><br/><br/><br/></div>
            </div>
          </div>
        </div>

        <!-- ======= FOOTER ======= -->
        <div class="footer">
          <div class="row"><br/><br/><br/></div>
          <table style="border:none;width:100%;">
            <tr>
              <td style="text-align:left;font-size:9px;">
                <t t-if="not is_bn">Powered by Eagle ERP</t>
                <t t-if="is_bn">Eagle ERP দ্বারা চালিত</t>
              </td>
              <td style="text-align:right;font-size:9px;">
                <t t-if="not is_bn">Page <span class="page"/> of <span class="topage"/></t>
                <t t-if="is_bn">পৃষ্ঠা <span class="page"/> এর <span class="topage"/></t>
              </td>
            </tr>
          </table>
        </div>

      </div>
    </template>

  </data>
</odoo>
