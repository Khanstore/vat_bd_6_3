                    </div>-->
                    <style>
                        table,td,th{
                        border:1px solid black;
                        }
                    </style>

                    <table class="table table-condensed" name="invoice_line_table">
                        <thead>
                            <tr>
                                <th colspan="10">

                                    <div class="row">
                                        <div class="col-2">Name of Purchaser:</div>
                                        <div class="col-6">
                                            <span t-field="o.partner_id"/>
                                        </div>
                                        <div class="col-2 ">Invoice No:</div>
                                        <div class="col-2 ">
                                            <span t-field="o.vat_challan_no"/>
                                            <!--                            <span t-field="o.name"/>-->
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-2">BIN of Purchaser:</div>
                                        <div class="col-6">
                                            <span t-field="o.partner_id.bin"/>
                                        </div>
                                        <div class="col-2 ">Date of Issue:</div>
                                        <div class="col-2 ">
                                            <span t-field="o.date"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-2">Destination of Supply:</div>
                                        <div class="col-6">
                                            <span t-field="o.partner_id"/>
                                        </div>
                                        <div class="col-2 ">Time of Issue:</div>
                                        <div class="col-2 ">
                                            <span t-field="o.time_invoice"/>
                                        </div>


                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <th class="text-right" width="1fr">SL</th>
                                <th class="text-left" width="5fr">Goods/Service Description(Incases with Brand Name)</th>
                                <th class="text-right" width="1fr">Unit of Supply </th>
                                <th class="text-right" width="1fr">Quantity</th>
                                <th class="text-right" width="2fr">Unit Value (TAKA)</th>
                                <th class="text-right" width="3fr">Total Value (TAKA)</th>
                                <th class="text-right" width="2fr">Amount Supplementary Duty (TAKA)</th>
                                <th class="text-right" width="1fr">Value Added Tax rate/Specific Tax</th>
                                <th class="text-right" width="2fr">Value Added Tax rate/ Specific Tax Amount(TAKA)</th>
                                <th class="text-right" width="3fr">Value with all kinds of Duty &amp; Tax </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="serial" t-value="1"/>
                            <tr t-foreach="o.invoice_line_ids" t-as="l">
                                <td>
                                    <span t-esc="serial"/>
                                    <t t-set="serial" t-value="serial+1"/>
                                </td>
                                <td>
                                    <span t-field="l.name"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="l.product_uom_id" />
                                </td>
                                <td>
                                    <span t-field="l.quantity"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="l.price_unit"/>
                                </td>
                                <td class="text-right" id="subtotal">
                                    <span t-field="l.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td t-if="display_discount" class="text-right">
                                    <span t-field="l.discount"/>
                                </td>
                                <td>
                                    <span t-field="l.invoice_line_supplimentary_tax"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_ids))"/>
                                </td>
                                <t t-set="total_tax" t-value="0"/>
                                <t t-foreach="l.tax_ids" t-as="tax_line">
                                    <t t-set="total_tax" t-value="total_tax + (l.price_subtotal*l.tax_ids.amount/100)"/>
                                </t>
                                <td>
                                    <span t-esc="total_tax"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td>
                                    <span t-esc="total_tax+l.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr t-foreach="range(max(5-len(o.invoice_line_ids),0))" t-as="l">
                                <td t-translation="off">&amp;nbsp;</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="5" text_align="right">Total</td>

                                <td>
                                    <span t-field="o.amount_untaxed"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td></td>
                                <td></td>
                                <td>
                                    <span t-field="o.amount_tax"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td>
                                    <span t-field="o.amount_total"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="row">
                        <br/>
                        <br/>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Name of organization Officer-in-charge:
                        </div>
                        <div class="col-8">
                            <span t-field="o.user_id"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Designation:
                        </div>
                        <div class="col-8">
                            <span t-field="o.user_id.partner_id.function"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Signature:
                        </div>
                        <div class="col-8">
                            <br/>
                            <br/>
                            <br/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4">
                            Seal:
                            <br/>

                        </div>
                        <div class="col-8">
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                        </div>
                    </div>
                </div>
            </t>
        </template>
  </data>
</odoo>