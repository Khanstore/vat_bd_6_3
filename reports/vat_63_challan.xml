<odoo>
  <data>

      <template id="external_layout_vat63">
            <div class="header" width="100%">
                <style>
                    @font-face {
                    font-family: Bangla; src: vat_bd_6_3/static/src/fonts/kalpurush.ttf;
                    }
                    div {
                    font-family: Bangla;
                    }

                </style>
                <div class="row">
                    <table class="table table-bordered" style="border-color:white;" width="100%" >
                        <tr>
                            <td width="5%"></td>
                            <td rowspan="4" width="13%" style="border-color:white;">
                                <div style="width: 100%;">
                                    <img src='/vat_bd_6_3/static/src/img/bd_gov_logo.png' style="width:100%"/>
                                </div>
                            </td>
                            <td rowspan="2" width="60%">
                                <div style="width: 100%;text-align:center;" class="bangla">
                                    <bangla>Government of the People's Republic of Bangladesh</bangla>
                                    <h3>National Board of Revenue</h3>
                                    <h6>Tax Challan</h6>
                                    [See Clauses (C) and (f) of Sub-Rule (1) of Rule 40]
                                </div>
                            </td>
                            <td style="border: 1px solid black;text-align:center; padding-top:6px;padding-bottom:6px;padding-left:6px;padding-right:6px; width:10%">
                                MUSHAK 6.3
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="font-size: 8px; "><span t-field="o.name"/>
                            </td>
                        </tr>



                        <tr>
                            <td></td>
                            <td text_allign="center">
                                <div style="width:100%">
                                    <bangla style=" text-align: left;" t-if="res_company.name">
                                        Name of Registered Person:
                                        <span t-field="res_company.name"/>
                                    </bangla>
                                    <h6>BIN of Registered Person:
                                        <span t-field="res_company.bin"/>
                                    </h6>
                                    <h6 style=" text-align: left;">Challan Issuing Address:
                                        <t t-if="res_company.street">
                                            <span t-field="res_company.street"/>
                                        </t>
                                        <t t-if="res_company.street2">
                                            <span t-field="res_company.street2"/>
                                        </t>
                                        <t t-if="res_company.country_id">
                                            <span t-field="res_company.country_id"/>
                                        </t>
                                    </h6>
                                </div>
                            </td>
                            <td></td>
                        </tr>
                    </table>


                </div>
            </div>
            <div class="article ">
                <t t-raw="0"/>
            </div>

            <!--<div class="footer o_boxed_footer">-->
            <div class="footer">
                <div class="row">
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                </div>
                <div class="row">
                </div>
                <div class="row">
                    <table style="border:none;width:100%;">
                        <tr>
                            <td style="text-align: left; padding-left: 300px; font-size:9px;">Powered by Eagle ERP</td>
                            <td></td>
                            <td style="text-align: right; font-size:9px;">
                                <span>Page</span>
                                <span class="page"/>
                                of
                                <span class="topage"/>
                            </td>
                        </tr>
                    </table>

                </div>
            </div>
            <!--</div>-->
        </template>
<template id="report_vat_63_challan">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-if="user.lang=='en_US'">
                        <t t-call="vat_bd_6_3.vat_63_challan_form_bangla" t-lang="o.partner_id.lang"/>
                    </t>
                    </t>
            </t>
        </template>

        <template id="vat_63_challan_form_bangla">
            <t t-call="vat_bd_6_3.external_layout_vat63">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>

                <div class="page">

                    <!--<div class="row">
                        <div class="col-2">ক্রেতার নামঃ</div>
                        <div class="col-6">
                            <span t-field="o.partner_id"/>
                        </div>
                        <div class="col-2 ">চালানপত্র নম্বরঃ</div>
                        <div class="col-2 ">
&lt;!&ndash;                            <span t-field="o.name"/>&ndash;&gt;
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">ক্রেতার বিআইএনঃ</div>
                        <div class="col-6">
                            <span t-field="o.partner_id.bin"/>
                        </div>
                        <div class="col-2 ">ইস্যুর তারিখঃ</div>
                        <div class="col-2 ">
                            <span t-field="o.date"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">সরবরাহের গন্তব্যস্থলঃ</div>
                        <div class="col-6">
                            <span t-field="o.partner_id"/>
                        </div>
                        <div class="col-2 ">ইস্যুর সময়ঃ</div>
                        <div class="col-2 ">
                            <span t-field="o.time_invoice"/>
